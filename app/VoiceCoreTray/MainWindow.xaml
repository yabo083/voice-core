<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="VoiceCoreTray.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:tb="using:H.NotifyIcon">

    <Grid x:Name="Root" Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- the dialog is a separate transparent window (Dialog/DialogWindow) -->

        <!-- status view: everything shown here comes from GET /api/status -->
        <Grid x:Name="StatusView" Grid.Row="1" Visibility="Collapsed" Padding="28,8,28,24">
            <StackPanel Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="服务状态" FontSize="16" FontWeight="SemiBold"/>
                <StackPanel x:Name="StatusList" Spacing="8"/>
                <TextBlock x:Name="StatusNote" FontSize="12" TextWrapping="Wrap" MaxHeight="60"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="voice-core: 启动中..."
                        ContextMenuMode="SecondWindow">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Name="MenuStart" Text="启动服务" Click="OnStartClick"/>
                    <MenuFlyoutItem x:Name="MenuStop" Text="停止服务" Click="OnStopClick"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Name="MenuStatus" Text="服务状态" Click="OnStatusClick"/>
                    <MenuFlyoutItem x:Name="MenuWarm" Text="预热声线模型" Click="OnWarmClick"/>
                    <MenuFlyoutItem x:Name="MenuSleep" Text="释放显存（保留服务）" Click="OnSleepClick"/>
                    <MenuFlyoutSeparator/>
                    <ToggleMenuFlyoutItem x:Name="MenuSubtitles" Text="显示对话框" IsChecked="True" Click="OnSubtitleToggle"/>
                    <ToggleMenuFlyoutItem x:Name="MenuAutoplay" Text="自动播放声音" IsChecked="True" Click="OnAutoplayToggle"/>
                    <ToggleMenuFlyoutItem x:Name="MenuPin" Text="钉住对话框（不自动隐藏）" Click="OnPinToggle"/>
                    <MenuFlyoutItem x:Name="MenuHistory" Text="历史对话" Click="OnHistoryClick"/>
                    <MenuFlyoutItem Text="复位对话框位置" Click="OnResetSubtitlePositionClick"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="打开日志目录" Click="OnLogsClick"/>
                    <MenuFlyoutItem Text="设置（含声线包）" Click="OnSettingsClick"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="退出并停止服务" Click="OnExitClick"/>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
