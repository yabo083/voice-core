{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceCore",
  "mainBinaryName": "VoiceCore",
  "version": "1.4.0",
  "identifier": "io.github.yabo083.voicecore",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "voice-core",
        "width": 1040,
        "height": 720,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "visible": true,
        "theme": "Dark",
        "backgroundColor": "#1c1c1c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
